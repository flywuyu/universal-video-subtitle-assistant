{
  "manifest_version": 3,
  "name": "通用视频字幕助手",
  "version": "0.3.0",
  "description": "优先读取现成字幕；没有字幕时使用本机语音识别。",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage",
    "downloads",
    "tabCapture",
    "nativeMessaging",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开通用视频字幕助手"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "content_scripts": [{
    "matches": ["https://*.youtube.com/*","https://*.bilibili.com/*","https://*.douyin.com/*","https://*.tiktok.com/*"],
    "js": ["pageBridge.js"],
    "run_at": "document_start",
    "world": "MAIN"
  }],
  "key": ""
}
